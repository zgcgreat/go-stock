# ============================================
# 后端 Dockerfile
# ============================================

# 阶段1: 构建
FROM golang:1.26-alpine AS builder

# 安装必要工具
RUN apk add --no-cache git ca-certificates gcc musl-dev

WORKDIR /app

# 复制 go mod 文件
COPY go.mod go.sum ./

# 设置 Go 代理（国内网络优化）
ENV GOPROXY=https://goproxy.cn,direct

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建后端 — 使用独立的 Web 服务入口
# ./web/main.go 启动完整的 Gin Web 服务器，包含全部 /api/v1/ 路由和前端 SPA 托管
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o go-stock-web ./web/

# 阶段2: 运行
FROM alpine:latest

# 安装必要工具 + Chromium（chromedp 获取雪球 cookie 依赖）
# chromium 会自动拉取 X11/GL 等运行时库，无需逐个声明
RUN apk --no-cache add \
    ca-certificates \
    tzdata \
    wget \
    chromium \
    fontconfig \
    freetype \
    nss \
    nss-tools \
    cups-libs \
    dbus-libs

# 设置时区与端口（web/main.go 使用 GO_STOCK_WEB_PORT，默认 8080）
ENV TZ=Asia/Shanghai
ENV GO_STOCK_WEB_PORT=8080

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/go-stock-web .

# 复制前端构建产物（web/main.go 通过 StaticDir=frontend/dist 提供静态文件服务）
COPY --from=builder /app/frontend/dist ./frontend/dist

# 创建必要的目录
RUN mkdir -p logs data

EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./go-stock-web"]
